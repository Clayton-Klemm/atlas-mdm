{
  "name": "atlas-mdm",
  "version": "1.0.0",
  "private": true,
  "description": "Governed electrical product master data: stewardship, approval, and resilient ERP delivery.",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node scripts/dev.js",
    "test": "node --test test/*.test.js",
    "test:ui": "playwright test",
    "spec": "node scripts/generate-spec.js",
    "check": "node scripts/check.js",
    "format": "prettier --write \"{src,scripts,test,e2e,public}/**/*.{js,css,html}\" playwright.config.js",
    "format:check": "prettier --check \"{src,scripts,test,e2e,public}/**/*.{js,css,html}\" playwright.config.js",
    "format": "prettier --write \"{src,scripts,test,e2e,public}/**/*.{js,css,html}\" playwright.config.js",
    "format:check": "prettier --check \"{src,scripts,test,e2e,public}/**/*.{js,css,html}\" playwright.config.js",
    "demo": "node scripts/demo.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "verify:backup": "node scripts/verify-backup.js"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9"
  }
}
